+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from unittest.mock import Mock
+
+import pytest
+
+from vllm.v1.worker.gpu import cudagraph_utils
+
+
+def test_capture_diagnostic_stage_is_opt_in(monkeypatch: pytest.MonkeyPatch):
+    sync = Mock()
+    monkeypatch.delenv("VLLM_CUDAGRAPH_CAPTURE_DIAGNOSTICS", raising=False)
+    monkeypatch.setattr(cudagraph_utils.torch.accelerator, "synchronize", sync)
+
+    with cudagraph_utils._capture_diagnostic_stage("test", "disabled", None):
+        pass
+
+    sync.assert_not_called()
+
+
+def test_capture_diagnostic_stage_synchronizes(monkeypatch: pytest.MonkeyPatch):
+    sync = Mock()
+    monkeypatch.setenv("VLLM_CUDAGRAPH_CAPTURE_DIAGNOSTICS", "1")
+    monkeypatch.setattr(cudagraph_utils, "is_global_first_rank", lambda: False)
+    monkeypatch.setattr(cudagraph_utils.torch.accelerator, "synchronize", sync)
+
+    with cudagraph_utils._capture_diagnostic_stage("test", "enabled", None):
+        pass
+
+    sync.assert_called_once_with()
+
+
+def test_capture_diagnostic_stage_propagates_sync_failure(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    monkeypatch.setenv("VLLM_CUDAGRAPH_CAPTURE_DIAGNOSTICS", "1")
+    monkeypatch.setattr(cudagraph_utils, "is_global_first_rank", lambda: False)
+    monkeypatch.setattr(
+        cudagraph_utils.torch.accelerator,
+        "synchronize",
+        Mock(side_effect=RuntimeError("sentinel async fault")),
+    )
+
+    with pytest.raises(RuntimeError, match="sentinel async fault"):
+        with cudagraph_utils._capture_diagnostic_stage("test", "failure", None):
+            pass
