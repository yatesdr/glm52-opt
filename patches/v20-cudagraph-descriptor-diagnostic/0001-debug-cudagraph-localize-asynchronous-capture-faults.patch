@@ -46,6 +47,46 @@ from vllm.v1.worker.utils import AttentionGroup
 logger = init_logger(__name__)
 
 
+def _capture_diagnostics_enabled() -> bool:
+    return os.getenv("VLLM_CUDAGRAPH_CAPTURE_DIAGNOSTICS", "0") == "1"
+
+
+@contextmanager
+def _capture_diagnostic_stage(
+    capture_label: str,
+    stage: str,
+    desc: "BatchExecutionDescriptor | None",
+):
+    """Synchronize after one completed capture stage when diagnostics are on.
+
+    The synchronization runs outside any nested ``torch.cuda.graph`` context,
+    so an asynchronous fault is attributed to the stage that launched it
+    instead of surfacing in the next descriptor's input preparation.
+    """
+    enabled = _capture_diagnostics_enabled()
+    if enabled and is_global_first_rank():
+        logger.warning(
+            "CG_DIAG BEGIN label=%s stage=%s desc=%s", capture_label, stage, desc
+        )
+    try:
+        yield
+        if enabled:
+            torch.accelerator.synchronize()
+    except BaseException:
+        if enabled:
+            logger.exception(
+                "CG_DIAG FAIL label=%s stage=%s desc=%s",
+                capture_label,
+                stage,
+                desc,
+            )
+        raise
+    if enabled and is_global_first_rank():
+        logger.warning(
+            "CG_DIAG PASS label=%s stage=%s desc=%s", capture_label, stage, desc
+        )
+
+
