+def _decode_forced_num_splits(
+    *, is_spec_decode: bool, max_num_splits: int
+) -> int:
+    """Keep verifier attention in one FP32 accumulation domain.
+
+    The split-K decode path stores every partition's normalized value vector in
+    the BF16 ``tmp_output`` workspace before the FP32 merge.  That intermediate
+    rounding is acceptable for ordinary one-token decode, where split-K is the
+    established throughput path, but it is not numerically equivalent to the
+    single-pass verifier path: cancellation between partitions can lose a
+    signal that a single FP32 accumulation preserves.
+
+    A genuine multi-token MTP verification batch therefore uses one split.  It
+    still uses the decode kernel and its CUDA-graph path; only the lossy
+    intermediate partition boundary is removed.  Explicitly forced short
+    prefills are not verifier batches and retain the requested split count.
+    """
+    if is_spec_decode:
+        return 1
+    return max(1, int(max_num_splits))
+
