+        ext.dma_set_flag(
+            self._flag_ptr(prv, done),
+            self._counter_ptr(self._send_counters, done),
+        )
+        ext.dma_wait_flag(
+            self._flag_ptr(rank, done),
+            self._counter_ptr(self._wait_counters, done),
+        )
