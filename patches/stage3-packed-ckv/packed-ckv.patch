+                f"contract: existing={stored_key}, requested={key}"
+            )
+        if channel is _CKV_FAILED:
+            raise RuntimeError(
+                "Packed-CKV communicator initialization previously failed on "
+                "at least one DCP rank; restart with "
+                "B12X_DCP_PREFILL_TRANSPORT=query"
+            )
+        return channel
+
+    channel = None
