+        ranges = tuple(self._byte_range(tensor) for tensor in tensors)
+        if any(
+            self._overlaps(ranges[left], ranges[right])
+            for left, right in ((0, 1), (0, 2), (1, 2))
+        ):
+            raise ValueError("all-gather input and outputs must be disjoint")
+
+        record_offsets = [0]
+        metadata_offsets = [0]
+        for record_bytes, metadata_bytes in zip(records, metadata):
+            record_offsets.append(record_offsets[-1] + record_bytes)
+            metadata_offsets.append(metadata_offsets[-1] + metadata_bytes)
+
+        ext = self._ext
+        rank = self.rank
+        nxt = (rank + 1) % self.world_size
+        prv = (rank - 1) % self.world_size
+        main = torch.cuda.current_stream(self.device)
+        copy_stream = self._copy_stream
+        flag_stream = self._flag_stream
+        self._input_ready.record(main)
+
+        gathered_records.narrow(
+            0, record_offsets[rank], local_record_bytes
+        ).copy_(local_payload.narrow(0, 0, local_record_bytes))
+        gathered_metadata.narrow(
+            0, metadata_offsets[rank], local_metadata_bytes
+        ).copy_(
+            local_payload.narrow(
+                0, local_record_bytes, local_metadata_bytes
+            )
+        )
+
+        for step in range(self.world_size - 1):
+            owner = (rank - step) % self.world_size
