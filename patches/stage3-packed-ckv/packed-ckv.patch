+            1, device=device
+        )
+        dist.all_reduce(vote, op=dist.ReduceOp.MIN, group=device_group)
+        agreed = bool(vote.item() >= 1.0)
+    except Exception as exc:
+        logger.error("Packed-CKV communicator group vote failed: %s", exc)
+
+    if not agreed:
+        if channel is not None:
+            close = getattr(channel, "close", None)
+            if callable(close):
