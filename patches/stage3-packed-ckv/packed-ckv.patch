+
+        channel = PCIeDmaAllGather(
+            exchange_group=device_group,
+            device=device,
+            max_local_record_bytes=int(max_local_record_bytes),
+            max_local_metadata_bytes=int(max_local_metadata_bytes),
+        )
+    except Exception as exc:
+        logger.error("Packed-CKV local communicator init failed: %s", exc)
+        channel = None
+
+    agreed = False
+    try:
+        if device_group is None:
+            raise RuntimeError("DCP group has no device process group for vote")
