+class PCIeDmaAllGather:
+    """Fixed-capacity byte-preserving four-rank ring all-gather.
+
+    The three IPC slots hold received/forwarded payloads. Records and their
+    one-byte-per-page validity metadata travel together, then land in separate
+    caller-owned rank-major outputs. Calls are eager and ordered on one current
+    CUDA stream; concurrent use requires a separate channel.
+    """
+
+    def __init__(
+        self,
+        *,
+        exchange_group: ProcessGroup,
+        device: torch.device | int | str,
+        max_local_record_bytes: int,
+        max_local_metadata_bytes: int,
+        ext_module=None,
+    ) -> None:
+        self.group = exchange_group
+        self.rank = dist.get_rank(group=exchange_group)
+        self.world_size = dist.get_world_size(group=exchange_group)
+        self.device = (
+            device
+            if isinstance(device, torch.device)
+            else torch.device(
+                f"cuda:{device}" if isinstance(device, int) else device
+            )
+        )
+        if self.device.type != "cuda":
+            raise ValueError("PCIe byte all-gather requires a CUDA device")
+        if self.world_size != 4:
+            raise ValueError(
+                "PCIe byte all-gather is validated only for world size 4, "
+                f"got {self.world_size}"
+            )
+        if self.device.index != torch.cuda.current_device():
+            raise ValueError(
+                "PCIe byte all-gather device must be current: "
+                f"configured={self.device.index}, current="
+                f"{torch.cuda.current_device()}"
+            )
+
+        self.max_local_record_bytes = int(max_local_record_bytes)
+        self.max_local_metadata_bytes = int(max_local_metadata_bytes)
+        if self.max_local_record_bytes <= 0:
+            raise ValueError("max_local_record_bytes must be positive")
+        if self.max_local_metadata_bytes <= 0:
+            raise ValueError("max_local_metadata_bytes must be positive")
+
+        self._ext = ext_module or _load_extension()
+        self._ipc = CudaRTLibrary()
+        self._ipc.cudaSetDevice(self.device.index or 0)
+        self._closed = False
