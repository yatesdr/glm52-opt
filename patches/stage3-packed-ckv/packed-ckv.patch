+            with torch.cuda.stream(copy_stream):
+                if step == 0:
+                    copy_stream.wait_event(self._input_ready)
+                    source = local_payload.data_ptr()
+                else:
+                    copy_stream.wait_event(self._received_events[step - 1])
+                    source = self._slot_ptr(rank, step - 1)
+                ext.dma_copy(self._slot_ptr(nxt, step), source, send_bytes)
+                self._copied_events[step].record(copy_stream)
+            with torch.cuda.stream(flag_stream):
+                flag_stream.wait_event(self._copied_events[step])
+                ext.dma_set_flag(
+                    self._flag_ptr(nxt, step),
+                    self._counter_ptr(self._send_counters, step),
+                )
+
+            ext.dma_wait_flag(
+                self._flag_ptr(rank, step),
+                self._counter_ptr(self._wait_counters, step),
+            )
