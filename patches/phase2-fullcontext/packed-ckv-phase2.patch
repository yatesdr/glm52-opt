+@triton.jit
+def _remap_ckv_pool_topk_kernel(
+    req_ids_ptr,
+    topk_ptr,
+    owner_tables_ptr,
+    global_causal_ptr,
+    out_ptr,
+    valid_counts_ptr,
+    selected_total_ptr,
+    missing_total_ptr,
+    topk_stride0,
+    topk_stride1,
+    table_stride0,
+    table_stride1,
+    table_stride2,
+    out_stride0,
+    out_stride1,
+    TABLE_WIDTH,
+    POOL_PAGES,
+    TOPK: tl.constexpr,
+    PROFILE: tl.constexpr,
+    VIRTUAL_BLOCK: tl.constexpr,
+    WORLD_SIZE: tl.constexpr,
+    PAGE_RECORDS: tl.constexpr,
+):
+    row = tl.program_id(0)
+    offsets = tl.arange(0, TOPK)
+    request = tl.load(req_ids_ptr + row)
+    logical_ids = tl.load(
+        topk_ptr + row * topk_stride0 + offsets * topk_stride1
+    )
+    causal_length = tl.load(global_causal_ptr + row)
+    virtual_block = logical_ids // VIRTUAL_BLOCK
+    within_virtual = logical_ids % VIRTUAL_BLOCK
+    owner = within_virtual % WORLD_SIZE
+    local_offset = within_virtual // WORLD_SIZE
+    logical_valid = (logical_ids >= 0) & (logical_ids < causal_length)
+    table_valid = logical_valid & (virtual_block >= 0) & (
+        virtual_block < TABLE_WIDTH
+    )
+    physical_block = tl.load(
+        owner_tables_ptr
+        + owner * table_stride0
+        + request * table_stride1
+        + virtual_block * table_stride2,
+        mask=table_valid,
+        other=-1,
+    )
+    is_valid = table_valid & (physical_block >= 0) & (
+        physical_block < POOL_PAGES
+    )
+    mapped = (
+        (owner * POOL_PAGES + physical_block) * PAGE_RECORDS
+        + local_offset
+    )
+
+    output_row = out_ptr + row * out_stride0
+    tl.store(output_row + offsets * out_stride1, -1)
+    integer_valid = is_valid.to(tl.int32)
+    compact_offset = tl.cumsum(integer_valid, axis=0) - integer_valid
+    tl.store(
+        output_row + compact_offset * out_stride1,
+        mapped,
+        mask=is_valid,
+    )
+    valid_count = tl.sum(integer_valid, axis=0)
+    tl.store(valid_counts_ptr + row, valid_count)
+    if PROFILE:
+        missing_count = tl.sum(
+            (table_valid & (is_valid == 0)).to(tl.int32), axis=0
+        )
+        tl.atomic_add(selected_total_ptr, valid_count.to(tl.int64))
+        tl.atomic_add(missing_total_ptr, missing_count.to(tl.int64))
