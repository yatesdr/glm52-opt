+def _ckv_direct_all_gather_backend(dcp_group):
+    communicator = getattr(dcp_group, "device_communicator", None)
+    pynccl_comm = getattr(communicator, "pynccl_comm", None)
+    if pynccl_comm is not None and not getattr(
+        pynccl_comm, "disabled", False
+    ):
+        return pynccl_comm, None
+    device_group = getattr(dcp_group, "device_group", None)
+    if device_group is None:
+        device_group = getattr(communicator, "device_group", None)
+    if device_group is not None:
+        return None, device_group
+    raise RuntimeError(
+        "Packed-CKV phase 2 requires direct PyNCCL or a DCP device process "
+        "group; allocating GroupCoordinator.all_gather fallback is forbidden"
+    )
+
+
+def _ckv_direct_all_gather_into(
+    dcp_group,
+    output_tensor: torch.Tensor,
+    input_tensor: torch.Tensor,
+) -> None:
+    if (
+        not input_tensor.is_contiguous()
+        or not output_tensor.is_contiguous()
+        or output_tensor.dtype != input_tensor.dtype
+        or output_tensor.device != input_tensor.device
+        or output_tensor.numel()
+        != input_tensor.numel() * int(dcp_group.world_size)
+    ):
+        raise RuntimeError(
+            "Packed-CKV phase-2 all-gather requires caller-owned contiguous "
+            "same-dtype views with exact rank-concatenated size"
+        )
+    pynccl_comm, device_group = _ckv_direct_all_gather_backend(dcp_group)
+    if pynccl_comm is not None:
+        pynccl_comm.all_gather(output_tensor, input_tensor)
+        return
+    if device_group is None:
+        raise RuntimeError("Packed-CKV phase-2 all-gather backend disappeared")
+    dist.all_gather_into_tensor(
+        output_tensor,
+        input_tensor,
+        group=device_group,
+    )
