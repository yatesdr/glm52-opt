+class _CKVHeadroomEscrow:
+    """One-shot direct-CUDA reservation protecting first-prefill headroom."""
+
+    def __init__(
+        self,
+        *,
+        exchange_group: ProcessGroup,
+        device: torch.device,
+    ) -> None:
+        self.group = exchange_group
+        self.device = device
+        self.rank = dist.get_rank(group=exchange_group)
+        self.world_size = dist.get_world_size(group=exchange_group)
+        if self.world_size != 4 or not 0 <= self.rank < 4:
+            raise RuntimeError(
+                "CKV headroom escrow requires one four-rank DCP group, got "
+                f"world={self.world_size}, rank={self.rank}"
+            )
+        if self.device.type != "cuda" or self.device.index is None:
+            raise RuntimeError(
+                f"CKV headroom escrow requires an explicit CUDA device, got {device}"
+            )
+        if torch.cuda.current_device() != self.device.index:
+            raise RuntimeError(
+                "CKV headroom escrow device must be current: "
+                f"configured={self.device}, current={torch.cuda.current_device()}"
+            )
+
+        self.scalar = torch.empty(1, dtype=torch.int64, device=self.device)
+        self.ipc: CudaRTLibrary | None = None
+        self.pointer: int | None = None
+        self.state = "arming"
+        self.first_route = "unreleased"
+        self.first_route_bytes = 0
+        self.first_logical_blocks = 0
+        self.first_pool_pages = 0
+
+        free_before = -1
+        free_after = -1
+        local_error = ""
+        try:
+            free_before, _ = torch.cuda.mem_get_info(self.device)
+        except Exception as exc:
+            local_error = f"mem_get_info(before) {type(exc).__name__}: {exc}"
+        try:
+            self.ipc = CudaRTLibrary()
+            self.ipc.cudaSetDevice(self.device.index)
+            self.pointer = self.ipc.cudaMalloc(_CKV_ESCROW_BYTES)
+        except Exception as exc:
+            local_error = f"cudaMalloc {type(exc).__name__}: {exc}"
+        try:
+            free_after, _ = torch.cuda.mem_get_info(self.device)
+        except Exception as exc:
+            suffix = f"mem_get_info(after) {type(exc).__name__}: {exc}"
+            local_error = f"{local_error}; {suffix}" if local_error else suffix
+        local_ok = self.pointer is not None
+        self.scalar.fill_(1 if local_ok else 0)
+        try:
+            dist.all_reduce(self.scalar, op=dist.ReduceOp.MIN, group=self.group)
+            group_ok = bool(self.scalar.item() == 1)
+        except Exception:
+            self._free_local()
+            self.state = "dead"
+            raise
+
+        logger.info(
+            "CKV headroom escrow arm rank=%d driver_free_before=%d "
+            "driver_free_after=%d bytes=%d local_ok=%d group_ok=%d error=%s",
+            self.rank,
+            free_before,
+            free_after,
+            _CKV_ESCROW_BYTES,
+            int(local_ok),
+            int(group_ok),
+            local_error or "none",
+        )
+        if not group_ok:
+            self._free_local()
+            self.state = "dead"
+            raise RuntimeError(
+                "CKV headroom escrow allocation failed on at least one DCP rank"
+            )
+        self.state = "armed"
+
+    def _free_local(self) -> None:
+        if self.pointer is not None:
+            if self.ipc is None:
+                raise RuntimeError("CKV headroom escrow lost its CUDA runtime")
+            self.ipc.cudaFree(self.pointer)
+            self.pointer = None
+
+    def _probe(self, name: str) -> int:
+        sequence = 1 if name == "A" else 2
+        free_bytes, total_bytes = torch.cuda.mem_get_info(self.device)
+        self.scalar.fill_(int(free_bytes))
+        dist.all_reduce(self.scalar, op=dist.ReduceOp.MIN, group=self.group)
+        group_min = int(self.scalar.item())
+        logger.info(
+            "CKV headroom probe=%s sequence=%d rank=%d driver_free=%d "
+            "driver_total=%d "
+            "group_min_free=%d torch_allocated=%d torch_reserved=%d "
+            "route=%s logical_blocks=%d pool_pages=%d route_bytes=%d",
+            name,
+            sequence,
+            self.rank,
+            free_bytes,
+            total_bytes,
+            group_min,
+            torch.cuda.memory_allocated(self.device),
+            torch.cuda.memory_reserved(self.device),
+            self.first_route,
+            self.first_logical_blocks,
+            self.first_pool_pages,
+            self.first_route_bytes,
+        )
+        if group_min < _CKV_HEADROOM_GATE_BYTES:
+            self.state = "dead"
+            raise RuntimeError(
+                f"CKV headroom Probe {name} below 150 MiB: {group_min} bytes"
+            )
+        return group_min
+
+    def layer_entry(self) -> None:
+        if self.state == "armed":
+            return
+        if self.state == "probe_a":
+            self._probe("B")
+            self.state = "complete"
+            return
+        if self.state == "complete":
+            return
+        raise RuntimeError(
+            f"CKV headroom escrow entered a layer in invalid state {self.state!r}"
+        )
+
+    def release_after_first_attention(
+        self,
+        *,
+        route: str,
+        route_bytes: int,
+        logical_blocks: int,
+        pool_pages: int,
+    ) -> None:
+        if self.state != "armed" or self.pointer is None:
+            raise RuntimeError(
+                "CKV headroom escrow release requires the armed live pointer"
+            )
+        torch.cuda.synchronize(self.device)
+        self._free_local()
+        self.first_route = route
+        self.first_route_bytes = int(route_bytes)
+        self.first_logical_blocks = int(logical_blocks)
+        self.first_pool_pages = int(pool_pages)
+        if _CKV_HEADROOM_PROBES:
+            self._probe("A")
+            self.state = "probe_a"
+        else:
+            free_bytes, _ = torch.cuda.mem_get_info(self.device)
+            logger.info(
+                "CKV headroom escrow released rank=%d driver_free=%d "
+                "probes=disabled route=%s logical_blocks=%d "
+                "pool_pages=%d route_bytes=%d",
+                self.rank,
+                free_bytes,
+                self.first_route,
+                self.first_logical_blocks,
+                self.first_pool_pages,
+                self.first_route_bytes,
+            )
+            self.state = "complete"
+
+
+def arm_ckv_headroom_escrow(
+    *, exchange_group: ProcessGroup, device: torch.device | int | str
+) -> None:
+    """Arm the phase-2 reservation after all ordinary warmup has completed."""
+    if not _CKV_PHASE2_NCCL:
+        raise RuntimeError("CKV headroom escrow armed outside phase-2 NCCL mode")
+    if _CKV_ESCROW_SINGLETON:
+        raise RuntimeError("CKV headroom escrow may be armed only once per process")
+    cuda_device = (
+        device
+        if isinstance(device, torch.device)
+        else torch.device(f"cuda:{device}" if isinstance(device, int) else device)
+    )
+    _CKV_ESCROW_SINGLETON.append(
+        _CKVHeadroomEscrow(
+            exchange_group=exchange_group,
+            device=cuda_device,
+        )
+    )
+
+
+def ckv_headroom_layer_entry() -> None:
+    if not _CKV_PHASE2_NCCL:
+        return
+    if not _CKV_ESCROW_SINGLETON:
+        raise RuntimeError("CKV phase 2 reached attention before escrow arm")
+    _CKV_ESCROW_SINGLETON[0].layer_entry()
+
+
+def release_ckv_headroom_after_first_attention(
+    *,
+    route: str,
+    route_bytes: int,
+    logical_blocks: int,
+    pool_pages: int,
+) -> None:
+    if not _CKV_PHASE2_NCCL:
+        return
+    if not _CKV_ESCROW_SINGLETON:
+        raise RuntimeError("CKV phase 2 reached escrow release before arm")
+    escrow = _CKV_ESCROW_SINGLETON[0]
+    if escrow.state == "armed":
+        escrow.release_after_first_attention(
+            route=route,
+            route_bytes=int(route_bytes),
+            logical_blocks=int(logical_blocks),
+            pool_pages=int(pool_pages),
+        )
+
