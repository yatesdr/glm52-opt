diff --git a/vllm/model_executor/layers/compute_phase_profiler.py b/vllm/model_executor/layers/compute_phase_profiler.py
new file mode 100644
index 00000000..fadcdd84
--- /dev/null
+++ b/vllm/model_executor/layers/compute_phase_profiler.py
@@ -0,0 +1,915 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One-shot, compile-safe CUDA-event profiler for Gilded Gnosis v20.
+
+The public ``compute_profiler_*`` graph hooks are custom ops with mutable
+tensor dependencies.  Dynamo therefore keeps them in the compiled graph
+without a ``torch.compiler.disable`` graph break.  In decode mode their
+external CUDA events are captured into the real CUDA graph and updated on
+replay; a worker-lifetime device counter, initialized before graph capture,
+distinguishes the first live replay from startup capture.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Final
+
+import torch
+
+from vllm.config import CUDAGraphMode
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.logger import init_logger
+from vllm.utils.torch_utils import direct_register_custom_op
+
+logger = init_logger("vllm.compute_phase_profiler")
+
+COMPUTE_PROF_ENABLED: Final = os.getenv("B12X_COMPUTE_PROF", "0") == "1"
+
+_PHASES: Final = (
+    "layer_total",
+    "mla_total",
+    "indexer",
+    "attention_path",
+    "dcp_query_ag",
+    "ckv_remap",
+    "ckv_pack",
+    "ckv_ag",
+    "ckv_wait",
+    "ckv_stage",
+    "sparse_attn",
+    "v_up_proj",
+    "dcp_lse_ag",
+    "dcp_lse_correct",
+    "dcp_output_rs",
+    "dcp_a2a_pack",
+    "dcp_a2a",
+    "dcp_a2a_merge",
+    "o_proj_norm",
+    "tp_ar_attention",
+    "moe_next_norm",
+    "moe_stack",
+    # Decode uses the one-grid hybrid kernel. Prefill/fallback dispatches the
+    # kept and NF3 tiers separately, then adds their outputs. Keeping distinct
+    # phase names makes an unexpected route fail the mode-specific ledger.
+    "moe_hybrid_kernel",
+    "moe_kept_kernel",
+    "moe_nf3_kernel",
+    "moe_tier_sum",
+    "tp_ar_moe",
+    # Work-only side-stream durations. They overlap the critical path and are
+    # deliberately excluded from the exclusive wall-time ledger.
+    "ckv_prefetch_pack",
+    "ckv_prefetch_ag",
+)
+_PHASE_INDEX: Final = {name: index for index, name in enumerate(_PHASES)}
+_PARENTS: Final = {
+    "layer_total": None,
+    "mla_total": "layer_total",
+    "indexer": "mla_total",
+    "attention_path": "mla_total",
+    "dcp_query_ag": "attention_path",
+    "ckv_remap": "attention_path",
+    "ckv_pack": "attention_path",
+    "ckv_ag": "attention_path",
+    "ckv_wait": "attention_path",
+    "ckv_stage": "attention_path",
+    "sparse_attn": "attention_path",
+    "v_up_proj": "attention_path",
+    "dcp_lse_ag": "attention_path",
+    "dcp_lse_correct": "attention_path",
+    "dcp_output_rs": "attention_path",
+    "dcp_a2a_pack": "attention_path",
+    "dcp_a2a": "attention_path",
+    "dcp_a2a_merge": "attention_path",
+    "o_proj_norm": "mla_total",
+    "tp_ar_attention": "o_proj_norm",
+    "moe_next_norm": "layer_total",
+    "moe_stack": "moe_next_norm",
+    "moe_hybrid_kernel": "moe_stack",
+    "moe_kept_kernel": "moe_stack",
+    "moe_nf3_kernel": "moe_stack",
+    "moe_tier_sum": "moe_stack",
+    "tp_ar_moe": "moe_stack",
+    "ckv_prefetch_pack": "attention_path",
+    "ckv_prefetch_ag": "attention_path",
+}
+_ATTENTION_CRITICAL_CHILDREN: Final = (
+    "dcp_query_ag",
+    "ckv_remap",
+    "ckv_pack",
+    "ckv_ag",
+    "ckv_wait",
+    "ckv_stage",
+    "sparse_attn",
+    "v_up_proj",
+    "dcp_lse_ag",
+    "dcp_lse_correct",
+    "dcp_output_rs",
+    "dcp_a2a_pack",
+    "dcp_a2a",
+    "dcp_a2a_merge",
+)
+_AUX_PHASES: Final = ("ckv_prefetch_pack", "ckv_prefetch_ag")
+_TP_PHASES: Final = ("tp_ar_attention", "tp_ar_moe")
+_TP_EVENT_MULTIPLIER: Final = 4
+
+# Decode capture records an increment into the selected graph.  Its storage
+# must be allocated and initialized before capture begins: allocating it from
+# the marker implementation would capture torch.zeros() itself and leave no
+# durable initial value for live replay.  gpu_worker calls
+# compute_profiler_prepare() at the pre-capture lifecycle seam.
+_DECODE_REPLAY_COUNTER: torch.Tensor | None = None
+
+
+def _positive_int(name: str, default: int) -> int:
+    try:
+        value = int(os.getenv(name, str(default)))
+    except ValueError:
+        return default
+    return value if value > 0 else default
+
+
+def _nonnegative_int(name: str, default: int) -> int:
+    try:
+        value = int(os.getenv(name, str(default)))
+    except ValueError:
+        return default
+    return value if value >= 0 else default
+
+
+def _nonnegative_float(name: str, default: float) -> float:
+    try:
+        value = float(os.getenv(name, str(default)))
+    except ValueError:
+        return default
+    return value if value >= 0.0 else default
+
+
+class _ComputePhaseProfiler:
+    """Fixed-event, fail-closed state machine for one measured sample."""
+
+    _MAX_DEPTH: Final = 8
+
+    def __init__(self, mode: str) -> None:
+        if mode not in ("prefill", "decode"):
+            raise ValueError("B12X_COMPUTE_PROF_MODE must be prefill or decode")
+        self.mode = mode
+        self.target = _positive_int("B12X_COMPUTE_PROF_CALLS", 78)
+        self.first_layer = _nonnegative_int("B12X_COMPUTE_PROF_FIRST_LAYER", 0)
+        self.num_layers = _positive_int("B12X_COMPUTE_PROF_NUM_LAYERS", 78)
+        self.row_filter = _nonnegative_int("B12X_COMPUTE_PROF_ROWS", 0)
+        self.poll_tokens = _nonnegative_int("B12X_COMPUTE_PROF_POLL_TOKENS", 1)
+        self.expected_tp_attention = _nonnegative_int(
+            "B12X_COMPUTE_PROF_EXPECT_TP_ATTN", 1
+        )
+        self.expected_tp_moe = _nonnegative_int(
+            "B12X_COMPUTE_PROF_EXPECT_TP_MOE", 1
+        )
+        self.baseline_ms = _nonnegative_float(
+            "B12X_COMPUTE_PROF_BASELINE_MS", 0.0
+        )
+        self.top_n = _positive_int("B12X_COMPUTE_PROF_TOP_N", 8)
+
+        if self.mode == "decode" and self.target != self.num_layers:
+            raise ValueError(
+                "decode CUDA-graph profiling requires CALLS == NUM_LAYERS"
+            )
+
+        self.dead = False
+        self.dead_reason = ""
+        self.armed = False
+        self.summarized = False
+        self.poll_pending_logged = False
+        self.collecting = False
+        self.completed = 0
+        self.current_layer = -1
+        self.profile_rows = 0
+        self.depth = 0
+        self.stack: list[str | None] = [None] * self._MAX_DEPTH
+        self.phase_counts = [0] * len(_PHASES)
+        capacities = tuple(
+            self.target * _TP_EVENT_MULTIPLIER
+            if phase in _TP_PHASES
+            else self.target
+            for phase in _PHASES
+        )
+        external = self.mode == "decode"
+        self.starts = tuple(
+            tuple(
+                torch.cuda.Event(enable_timing=True, external=external)
+                for _ in range(capacity)
+            )
+            for capacity in capacities
+        )
+        self.ends = tuple(
+            tuple(
+                torch.cuda.Event(enable_timing=True, external=external)
+                for _ in range(capacity)
+            )
+            for capacity in capacities
+        )
+        self.tp_attention_calls = 0
+        self.tp_attention_bytes = 0
+        self.tp_moe_calls = 0
+        self.tp_moe_bytes = 0
+        self.tp_attention_per_layer = [0] * self.target
+        self.tp_moe_per_layer = [0] * self.target
+        self.context_bucket = 0
+        self.dcp_lse_bytes = 0
+        self.dcp_rs_bytes = 0
+        self.dcp_a2a_bytes = 0
+        if self.mode == "decode" and _DECODE_REPLAY_COUNTER is None:
+            raise RuntimeError(
+                "decode replay counter was not prepared before CUDA capture"
+            )
+        self.capture_replay_counter = (
+            _DECODE_REPLAY_COUNTER if self.mode == "decode" else None
+        )
+
+    def _disarm(self, reason: str, exc: Exception | None = None) -> None:
+        if self.dead:
+            return
+        self.dead = True
+        self.dead_reason = reason
+        logger.info(
+            "B12X_COMPUTE_PROF_V20 state=disarmed mode=%s reason=%s "
+            "completed=%d rows=%d error=%r",
+            self.mode,
+            reason,
+            self.completed,
+            self.profile_rows,
+            exc,
+        )
+
+    def _eligible_rows(self, rows: int) -> bool:
+        return self.row_filter == 0 or rows == self.row_filter
+
+    def start(self, phase: str) -> bool:
+        if self.dead or self.armed or not self.collecting:
+            return False
+        try:
+            phase_index = _PHASE_INDEX[phase]
+            expected_parent = _PARENTS[phase]
+            actual_parent = self.stack[self.depth - 1] if self.depth else None
+            if expected_parent != actual_parent or self.depth >= self._MAX_DEPTH:
+                self._disarm("phase_parent_or_depth")
+                return False
+            occurrence = self.phase_counts[phase_index]
+            if occurrence >= len(self.starts[phase_index]):
+                self._disarm("phase_capacity")
+                return False
+            self.starts[phase_index][occurrence].record()
+            self.stack[self.depth] = phase
+            self.depth += 1
+            return True
+        except Exception as exc:
+            self._disarm("phase_start_exception", exc)
+            return False
+
+    def stop(self, phase: str) -> None:
+        if self.dead or self.armed or not self.collecting:
+            return
+        try:
+            if self.depth <= 0 or self.stack[self.depth - 1] != phase:
+                self._disarm("phase_stop_order")
+                return
+            phase_index = _PHASE_INDEX[phase]
+            occurrence = self.phase_counts[phase_index]
+            self.ends[phase_index][occurrence].record()
+            self.phase_counts[phase_index] = occurrence + 1
+            self.depth -= 1
+            self.stack[self.depth] = None
+        except Exception as exc:
+            self._disarm("phase_stop_exception", exc)
+
+    def _close_layer(self) -> None:
+        if self.current_layer < 0:
+            self._disarm("close_without_layer")
+            return
+        self.stop("moe_next_norm")
+        self.stop("layer_total")
+        if self.dead:
+            return
+        self.completed += 1
+        self.current_layer = -1
+
+    def layer_enter(self, layer_idx: int, rows: int) -> None:
+        if self.dead or self.armed:
+            return
+        if not self.collecting:
+            if layer_idx != self.first_layer or not self._eligible_rows(rows):
+                return
+            self.collecting = True
+            self.profile_rows = rows
+        else:
+            self._close_layer()
+            if self.dead:
+                return
+            if self.completed == self.target:
+                self._arm()
+                return
+
+        expected = self.first_layer + (self.completed % self.num_layers)
+        if layer_idx != expected or rows != self.profile_rows:
+            self._disarm("layer_ordinal_or_rows")
+            return
+        self.current_layer = layer_idx
+        if not self.start("layer_total") or not self.start("mla_total"):
+            self._disarm("layer_open")
+
+    def o_proj_enter(self) -> None:
+        self.start("o_proj_norm")
+
+    def after_attention_norm(self, layer_idx: int) -> None:
+        if self.dead or self.armed or not self.collecting:
+            return
+        if layer_idx != self.current_layer:
+            self._disarm("attention_norm_layer")
+            return
+        self.stop("o_proj_norm")
+        self.stop("mla_total")
+        self.start("moe_next_norm")
+
+    def model_finish(self) -> None:
+        if self.dead or self.armed or not self.collecting:
+            return
+        self._close_layer()
+        if self.dead:
+            return
+        self.collecting = False
+        if self.completed == self.target:
+            self._arm()
+        elif self.mode == "decode":
+            # A captured decode sample is useful only when one graph contains
+            # exactly the requested main-model layer set.
+            self._disarm("decode_incomplete_model")
+
+    def _arm(self) -> None:
+        if self.depth != 0 or self.completed != self.target:
+            self._disarm("arm_incomplete")
+            return
+        self.collecting = False
+        self.armed = True
+        if self.mode == "decode":
+            if not torch.cuda.is_current_stream_capturing():
+                self._disarm("arm_outside_capture")
+                return
+            assert self.capture_replay_counter is not None
+            # This kernel is outside all timed ranges. Capture records the add
+            # without executing it; the first live graph replay changes the
+            # preinitialized counter from zero to one.
+            self.capture_replay_counter.add_(1)
+
+    def record_attention_shape(self, rows: int, context: int) -> None:
+        if not self.dead and not self.armed and self.collecting:
+            self.context_bucket += rows * context
+
+    def record_dcp_lse(self, byte_count: int) -> None:
+        if not self.dead and not self.armed and self.collecting:
+            self.dcp_lse_bytes += byte_count
+
+    def record_dcp_rs(self, byte_count: int) -> None:
+        if not self.dead and not self.armed and self.collecting:
+            self.dcp_rs_bytes += byte_count
+
+    def record_dcp_a2a(self, byte_count: int) -> None:
+        if not self.dead and not self.armed and self.collecting:
+            self.dcp_a2a_bytes += byte_count
+
+    def tp_start(self, byte_count: int) -> str | None:
+        if self.dead or self.armed or not self.collecting:
+            return None
+        phase = None
+        for index in range(self.depth - 1, -1, -1):
+            active = self.stack[index]
+            if active == "o_proj_norm":
+                phase = "tp_ar_attention"
+                break
+            if active == "moe_next_norm":
+                phase = "tp_ar_moe"
+                break
+        if phase is None or not self.start(phase):
+            return None
+        layer_ordinal = self.completed
+        if layer_ordinal >= self.target:
+            self._disarm("tp_layer_ordinal")
+            return None
+        if phase == "tp_ar_attention":
+            self.tp_attention_calls += 1
+            self.tp_attention_bytes += byte_count
+            self.tp_attention_per_layer[layer_ordinal] += 1
+        else:
+            self.tp_moe_calls += 1
+            self.tp_moe_bytes += byte_count
+            self.tp_moe_per_layer[layer_ordinal] += 1
+        return phase
+
+    def _phase_totals(self) -> dict[str, float]:
+        totals = {phase: 0.0 for phase in _PHASES}
+        for phase_index, phase in enumerate(_PHASES):
+            for occurrence in range(self.phase_counts[phase_index]):
+                totals[phase] += self.starts[phase_index][occurrence].elapsed_time(
+                    self.ends[phase_index][occurrence]
+                )
+        return totals
+
+    def ready_for_poll(self, scheduled_tokens: int) -> bool:
+        if self.dead or self.summarized or not self.armed:
+            return False
+        if self.mode == "decode" and (
+            self.poll_tokens > 0 and scheduled_tokens != self.poll_tokens
+        ):
+            return False
+        return os.getenv("B12X_VLLM_ENGINE_STARTED", "0") == "1"
+
+    def summarize(self) -> None:
+        try:
+            torch.cuda.synchronize()
+            if self.mode == "decode":
+                assert self.capture_replay_counter is not None
+                replay_count = int(self.capture_replay_counter.item())
+                if replay_count < 0:
+                    self._disarm("invalid_replay_counter")
+                    return
+                if replay_count == 0:
+                    if not self.poll_pending_logged:
+                        logger.info(
+                            "B12X_COMPUTE_PROF_V20 state=awaiting_replay "
+                            "rows=%d scheduled_capture_count=%d",
+                            self.profile_rows,
+                            replay_count,
+                        )
+                        self.poll_pending_logged = True
+                    return
+            totals = self._phase_totals()
+            layer_total = totals["layer_total"]
+            attention_children = sum(
+                totals[phase] for phase in _ATTENTION_CRITICAL_CHILDREN
+            )
+            moe_kernel_phases = (
+                "moe_hybrid_kernel",
+                "moe_kept_kernel",
+                "moe_nf3_kernel",
+                "moe_tier_sum",
+            )
+            exclusive = {
+                "layer_transition_other": layer_total
+                - totals["mla_total"]
+                - totals["moe_next_norm"],
+                "mla_prepare": totals["mla_total"]
+                - totals["indexer"]
+                - totals["attention_path"]
+                - totals["o_proj_norm"],
+                "indexer": totals["indexer"],
+                "attention_local": totals["attention_path"] - attention_children,
+                "dcp_query_ag": totals["dcp_query_ag"],
+                "ckv_remap": totals["ckv_remap"],
+                "ckv_pack": totals["ckv_pack"],
+                "ckv_ag": totals["ckv_ag"],
+                "ckv_wait": totals["ckv_wait"],
+                "ckv_stage": totals["ckv_stage"],
+                "sparse_attn": totals["sparse_attn"],
+                "v_up_proj": totals["v_up_proj"],
+                "dcp_lse_ag": totals["dcp_lse_ag"],
+                "dcp_lse_correct": totals["dcp_lse_correct"],
+                "dcp_output_rs": totals["dcp_output_rs"],
+                "dcp_a2a_pack": totals["dcp_a2a_pack"],
+                "dcp_a2a": totals["dcp_a2a"],
+                "dcp_a2a_merge": totals["dcp_a2a_merge"],
+                "o_proj_compute_norm": totals["o_proj_norm"]
+                - totals["tp_ar_attention"],
+                "tp_ar_attention": totals["tp_ar_attention"],
+                "moe_outer_next_norm": totals["moe_next_norm"]
+                - totals["moe_stack"],
+                "moe_hybrid_kernel": totals["moe_hybrid_kernel"],
+                "moe_kept_kernel": totals["moe_kept_kernel"],
+                "moe_nf3_kernel": totals["moe_nf3_kernel"],
+                "moe_tier_sum": totals["moe_tier_sum"],
+                "moe_stack_other": totals["moe_stack"]
+                - sum(totals[name] for name in moe_kernel_phases)
+                - totals["tp_ar_moe"],
+                "tp_ar_moe": totals["tp_ar_moe"],
+            }
+            exclusive_sum = sum(exclusive.values())
+            unaccounted_ms = layer_total - exclusive_sum
+            unaccounted_pct = (
+                100.0 * unaccounted_ms / layer_total if layer_total else 100.0
+            )
+            negative_buckets = sum(
+                value / self.completed < -0.05 for value in exclusive.values()
+            )
+            common_required = (
+                "layer_total",
+                "mla_total",
+                "indexer",
+                "attention_path",
+                "sparse_attn",
+                "v_up_proj",
+                "o_proj_norm",
+                "moe_next_norm",
+                "moe_stack",
+            )
+            mode_required = (
+                ("moe_hybrid_kernel",)
+                if self.mode == "decode"
+                else ("moe_kept_kernel", "moe_nf3_kernel", "moe_tier_sum")
+            )
+            mode_forbidden = (
+                ("moe_kept_kernel", "moe_nf3_kernel", "moe_tier_sum")
+                if self.mode == "decode"
+                else ("moe_hybrid_kernel",)
+            )
+            phase_count_valid = all(
+                self.phase_counts[_PHASE_INDEX[name]] == self.target
+                for name in common_required + mode_required
+            ) and all(
+                self.phase_counts[_PHASE_INDEX[name]] == 0
+                for name in mode_forbidden
+            )
+            ledger_valid = (
+                self.depth == 0
+                and phase_count_valid
+                and negative_buckets == 0
+                and abs(unaccounted_pct) <= 2.0
+            )
+            attention_bad_layers = sum(
+                self.tp_attention_per_layer[index] != self.expected_tp_attention
+                for index in range(self.completed)
+            )
+            moe_bad_layers = sum(
+                self.tp_moe_per_layer[index] != self.expected_tp_moe
+                for index in range(self.completed)
+            )
+            ordinal_valid = attention_bad_layers == 0 and moe_bad_layers == 0
+            mean_layer_ms = layer_total / self.completed
+            baseline_error_pct = (
+                100.0 * abs(mean_layer_ms - self.baseline_ms) / self.baseline_ms
+                if self.baseline_ms > 0.0
+                else 0.0
+            )
+            baseline_valid = self.baseline_ms == 0.0 or baseline_error_pct <= 5.0
+            per_layer = {
+                name: value / self.completed for name, value in exclusive.items()
+            }
+            top = sorted(per_layer.items(), key=lambda item: item[1], reverse=True)[
+                : self.top_n
+            ]
+            exclusive_text = ",".join(
+                f"{name}:{value:.4f}" for name, value in per_layer.items()
+            )
+            top_text = ",".join(f"{name}:{value:.4f}" for name, value in top)
+            aux_text = ",".join(
+                f"{name}:{totals[name] / self.completed:.4f}"
+                for name in _AUX_PHASES
+            )
+            phase_counts_text = ",".join(
+                f"{name}:{self.phase_counts[_PHASE_INDEX[name]]}"
+                for name in common_required + mode_required + mode_forbidden
+            )
+            route = "hybrid_one_grid" if self.mode == "decode" else "split_tiers"
+            rank = 0
+            if torch.distributed.is_initialized():
+                rank = torch.distributed.get_rank()
+            logger.info(
+                "B12X_COMPUTE_PROF_V20 rank=%d mode=%s calls=%d rows=%d "
+                "route=%s mean_layer_ms=%.4f ledger_valid=%d ordinal_valid=%d "
+                "phase_count_valid=%d phase_counts=%s "
+                "baseline_ms=%.4f baseline_error_pct=%.2f baseline_valid=%d "
+                "unaccounted_ms=%.6f unaccounted_pct=%.4f negative_buckets=%d "
+                "tp_attention_bad_layers=%d tp_moe_bad_layers=%d "
+                "tp_attention_calls=%d tp_attention_bytes=%d "
+                "tp_moe_calls=%d tp_moe_bytes=%d context_bucket=%d "
+                "dcp_lse_bytes=%d dcp_rs_bytes=%d dcp_a2a_bytes=%d "
+                "top_exclusive_ms=%s "
+                "exclusive_ms=%s aux_overlap_ms=%s",
+                rank,
+                self.mode,
+                self.completed,
+                self.profile_rows,
+                route,
+                mean_layer_ms,
+                int(ledger_valid),
+                int(ordinal_valid),
+                int(phase_count_valid),
+                phase_counts_text,
+                self.baseline_ms,
+                baseline_error_pct,
+                int(baseline_valid),
+                unaccounted_ms,
+                unaccounted_pct,
+                negative_buckets,
+                attention_bad_layers,
+                moe_bad_layers,
+                self.tp_attention_calls,
+                self.tp_attention_bytes,
+                self.tp_moe_calls,
+                self.tp_moe_bytes,
+                self.context_bucket,
+                self.dcp_lse_bytes,
+                self.dcp_rs_bytes,
+                self.dcp_a2a_bytes,
+                top_text,
+                exclusive_text,
+                aux_text,
+            )
+            self.summarized = True
+            self.dead = True
+        except Exception as exc:
+            self._disarm("summarize_exception", exc)
+
+
+_PROFILER: _ComputePhaseProfiler | None = None
+_INIT_FAILED = False
+_NO_PROFILER_POLL_LOGGED = False
+
+
+def _mode() -> str:
+    return os.getenv("B12X_COMPUTE_PROF_MODE", "prefill").strip().lower()
+
+
+def compute_profiler_prepare() -> None:
+    """Allocate decode replay evidence outside CUDA graph capture.
+
+    This is an explicit worker lifecycle hook rather than lazy marker state:
+    CUDA capture records allocator initialization kernels instead of executing
+    them, which cannot establish the counter's live pre-replay value.
+    """
+
+    global _DECODE_REPLAY_COUNTER
+    if not COMPUTE_PROF_ENABLED or _mode() != "decode":
+        return
+    if _DECODE_REPLAY_COUNTER is not None:
+        return
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError(
+            "decode replay counter preparation must run before CUDA capture"
+        )
+    counter = torch.zeros((), dtype=torch.int32, device="cuda")
+    torch.cuda.synchronize()
+    initial = int(counter.item())
+    if initial != 0:
+        raise RuntimeError(
+            f"decode replay counter initialization returned {initial}, expected 0"
+        )
+    _DECODE_REPLAY_COUNTER = counter
+    logger.info(
+        "B12X_COMPUTE_PROF_V20 state=replay_counter_prepared initial=%d",
+        initial,
+    )
+
+
+def _validate_configuration() -> None:
+    if not COMPUTE_PROF_ENABLED:
+        return
+    mode = _mode()
+    rows = _nonnegative_int("B12X_COMPUTE_PROF_ROWS", 0)
+    if mode not in ("prefill", "decode"):
+        raise ValueError("B12X_COMPUTE_PROF_MODE must be prefill or decode")
+    if mode == "decode" and rows == 0:
+        raise ValueError(
+            "decode profiling requires B12X_COMPUTE_PROF_ROWS to select one "
+            "CUDA-graph capture size"
+        )
+    logger.info(
+        "B12X_COMPUTE_PROF_V20 state=configured mode=%s rows=%d calls=%d "
+        "num_layers=%d poll_tokens=%d",
+        mode,
+        rows,
+        _positive_int("B12X_COMPUTE_PROF_CALLS", 78),
+        _positive_int("B12X_COMPUTE_PROF_NUM_LAYERS", 78),
+        _nonnegative_int("B12X_COMPUTE_PROF_POLL_TOKENS", 1),
+    )
+
+
+_validate_configuration()
+
+
+def _can_initialize(layer_idx: int, rows: int) -> bool:
+    if not COMPUTE_PROF_ENABLED:
+        return False
+    mode = _mode()
+    if mode == "prefill":
+        if torch.cuda.is_current_stream_capturing():
+            return False
+        if os.getenv("B12X_VLLM_ENGINE_STARTED", "0") != "1":
+            return False
+    elif mode == "decode":
+        if not torch.cuda.is_current_stream_capturing():
+            return False
+        # V2 CudaGraphManager captures PIECEWISE descriptors before FULL.
+        # Both execute the same ROWS-shaped model markers, so a rows-only
+        # selector arms on the wrong graph. FULL capture deliberately calls
+        # its forward_fn with runtime mode NONE inside torch.cuda.graph();
+        # PIECEWISE capture exposes PIECEWISE. Require that exact distinction
+        # so the recorded events and replay counter belong to the graph that
+        # live uniform MTP decode dispatches.
+        if not is_forward_context_available():
+            return False
+        if get_forward_context().cudagraph_runtime_mode != CUDAGraphMode.NONE:
+            return False
+    else:
+        return False
+    first_layer = _nonnegative_int("B12X_COMPUTE_PROF_FIRST_LAYER", 0)
+    row_filter = _nonnegative_int("B12X_COMPUTE_PROF_ROWS", 0)
+    return layer_idx == first_layer and (row_filter == 0 or rows == row_filter)
+
+
+def _maybe_profiler(layer_idx: int, rows: int) -> _ComputePhaseProfiler | None:
+    global _INIT_FAILED, _PROFILER
+    if _PROFILER is not None:
+        return _PROFILER
+    if _INIT_FAILED or not _can_initialize(layer_idx, rows):
+        return None
+    try:
+        _PROFILER = _ComputePhaseProfiler(_mode())
+    except Exception as exc:
+        _INIT_FAILED = True
+        logger.info(
+            "B12X_COMPUTE_PROF_V20 state=init_failed layer=%d rows=%d error=%r",
+            layer_idx,
+            rows,
+            exc,
+        )
+        return None
+    if _mode() == "decode":
+        logger.info(
+            "B12X_COMPUTE_PROF_V20 state=capture_selected rows=%d "
+            "runtime_mode=%s",
+            rows,
+            get_forward_context().cudagraph_runtime_mode.name,
+        )
+    return _PROFILER
+
+
+def _phase_start_impl(dependency: torch.Tensor, phase_index: int) -> None:
+    del dependency
+    profiler = _PROFILER
+    if profiler is not None and 0 <= phase_index < len(_PHASES):
+        profiler.start(_PHASES[phase_index])
+
+
+def _phase_stop_impl(dependency: torch.Tensor, phase_index: int) -> None:
+    del dependency
+    profiler = _PROFILER
+    if profiler is not None and 0 <= phase_index < len(_PHASES):
+        profiler.stop(_PHASES[phase_index])
+
+
+def _layer_enter_impl(dependency: torch.Tensor, layer_idx: int) -> None:
+    rows = int(dependency.shape[0])
+    profiler = _maybe_profiler(layer_idx, rows)
+    if profiler is not None:
+        profiler.layer_enter(layer_idx, rows)
+
+
+def _o_proj_enter_impl(dependency: torch.Tensor) -> None:
+    del dependency
+    if _PROFILER is not None:
+        _PROFILER.o_proj_enter()
+
+
+def _after_attention_norm_impl(dependency: torch.Tensor, layer_idx: int) -> None:
+    del dependency
+    if _PROFILER is not None:
+        _PROFILER.after_attention_norm(layer_idx)
+
+
+def _model_finish_impl(dependency: torch.Tensor) -> None:
+    del dependency
+    if _PROFILER is not None:
+        _PROFILER.model_finish()
+
+
+def _marker_fake(*args, **kwargs) -> None:
+    del args, kwargs
+
+
+direct_register_custom_op(
+    op_name="compute_profiler_phase_start",
+    op_func=_phase_start_impl,
+    mutates_args=["dependency"],
+    fake_impl=_marker_fake,
+)
+direct_register_custom_op(
+    op_name="compute_profiler_phase_stop",
+    op_func=_phase_stop_impl,
+    mutates_args=["dependency"],
+    fake_impl=_marker_fake,
+)
+direct_register_custom_op(
+    op_name="compute_profiler_layer_enter",
+    op_func=_layer_enter_impl,
+    mutates_args=["dependency"],
+    fake_impl=_marker_fake,
+)
+direct_register_custom_op(
+    op_name="compute_profiler_o_proj_enter",
+    op_func=_o_proj_enter_impl,
+    mutates_args=["dependency"],
+    fake_impl=_marker_fake,
+)
+direct_register_custom_op(
+    op_name="compute_profiler_after_attention_norm",
+    op_func=_after_attention_norm_impl,
+    mutates_args=["dependency"],
+    fake_impl=_marker_fake,
+)
+direct_register_custom_op(
+    op_name="compute_profiler_model_finish",
+    op_func=_model_finish_impl,
+    mutates_args=["dependency"],
+    fake_impl=_marker_fake,
+)
+
+
+def compute_profiler_phase_start(dependency: torch.Tensor, phase: str) -> None:
+    torch.ops.vllm.compute_profiler_phase_start(dependency, _PHASE_INDEX[phase])
+
+
+def compute_profiler_phase_stop(dependency: torch.Tensor, phase: str) -> None:
+    torch.ops.vllm.compute_profiler_phase_stop(dependency, _PHASE_INDEX[phase])
+
+
+def compute_profiler_layer_enter(dependency: torch.Tensor, layer_idx: int) -> None:
+    torch.ops.vllm.compute_profiler_layer_enter(dependency, layer_idx)
+
+
+def compute_profiler_o_proj_enter(dependency: torch.Tensor) -> None:
+    torch.ops.vllm.compute_profiler_o_proj_enter(dependency)
+
+
+def compute_profiler_after_attention_norm(
+    dependency: torch.Tensor, layer_idx: int
+) -> None:
+    torch.ops.vllm.compute_profiler_after_attention_norm(dependency, layer_idx)
+
+
+def compute_profiler_model_finish(dependency: torch.Tensor) -> None:
+    torch.ops.vllm.compute_profiler_model_finish(dependency)
+
+
+# Runtime hooks below are called from opaque custom-op implementations. They do
+# not participate in Dynamo tracing and intentionally have no compiler-disable
+# decorator.
+def compute_profiler_runtime_start(phase: str) -> None:
+    if _PROFILER is not None:
+        _PROFILER.start(phase)
+
+
+def compute_profiler_runtime_stop(phase: str) -> None:
+    if _PROFILER is not None:
+        _PROFILER.stop(phase)
+
+
+def compute_profiler_attention_shape(rows: int, context: int) -> None:
+    if _PROFILER is not None:
+        _PROFILER.record_attention_shape(rows, context)
+
+
+def compute_profiler_dcp_lse(byte_count: int) -> None:
+    if _PROFILER is not None:
+        _PROFILER.record_dcp_lse(byte_count)
+
+
+def compute_profiler_dcp_rs(byte_count: int) -> None:
+    if _PROFILER is not None:
+        _PROFILER.record_dcp_rs(byte_count)
+
+
+def compute_profiler_dcp_a2a(byte_count: int) -> None:
+    if _PROFILER is not None:
+        _PROFILER.record_dcp_a2a(byte_count)
+
+
+def compute_profiler_tp_start(byte_count: int) -> str | None:
+    if _PROFILER is None:
+        return None
+    return _PROFILER.tp_start(byte_count)
+
+
+def compute_profiler_tp_stop(phase: str | None) -> None:
+    if _PROFILER is not None and phase is not None:
+        _PROFILER.stop(phase)
+
+
+def compute_profiler_poll(scheduled_tokens: int) -> None:
+    global _NO_PROFILER_POLL_LOGGED
+    profiler = _PROFILER
+    if (
+        profiler is None
+        and COMPUTE_PROF_ENABLED
+        and not _INIT_FAILED
+        and not _NO_PROFILER_POLL_LOGGED
+        and os.getenv("B12X_VLLM_ENGINE_STARTED", "0") == "1"
+    ):
+        logger.info(
+            "B12X_COMPUTE_PROF_V20 state=no_selected_capture "
+            "configured_rows=%d scheduled_tokens=%d",
+            _nonnegative_int("B12X_COMPUTE_PROF_ROWS", 0),
+            scheduled_tokens,
+        )
+        _NO_PROFILER_POLL_LOGGED = True
+        return
+    if profiler is not None and profiler.ready_for_poll(scheduled_tokens):
+        profiler.summarize()
