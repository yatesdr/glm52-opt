FROM voipmonitor/vllm@sha256:131481b0f12c455a8fbad72c5909eb3a2c3accd96815743fdcfa134396e548c0

USER root

ARG NO_PREFIX_WRAPPER_SHA256

COPY vllm-no-prefix-caching /usr/local/libexec/glm52-causal/vllm

RUN set -eu; \
    test -n "${NO_PREFIX_WRAPPER_SHA256}"; \
    echo "${NO_PREFIX_WRAPPER_SHA256}  /usr/local/libexec/glm52-causal/vllm" | sha256sum -c -; \
    chmod 0755 /usr/local/libexec/glm52-causal/vllm

ENV PATH="/usr/local/libexec/glm52-causal:${PATH}"

LABEL org.opencontainers.image.title="GLM-5.2 v20 runtime-stride stock causal gate"
LABEL local.glm52.base.image.digest="sha256:131481b0f12c455a8fbad72c5909eb3a2c3accd96815743fdcfa134396e548c0"
LABEL local.glm52.base.vllm.commit="0c79e41db41f250ccdfc4be92d171960a5787f73"
LABEL local.glm52.base.sparkinfer.commit="c3828fd7f807ce237a9ac36ef033659e6f6b6dd3"
LABEL local.glm52.source.overlay="none"
LABEL local.glm52.prefix.caching="disabled-for-causal-gate"
