FROM voipmonitor/vllm@sha256:131481b0f12c455a8fbad72c5909eb3a2c3accd96815743fdcfa134396e548c0

USER root

ARG GLM_REFERENCE_INDEXER_SHA256=2f73eac49aa199f884bfebaa49c0449f033af665f26a6f48c386fb093ecdbe35
ARG DEEPSEEK_V2_SHA256=5b14912dad2b006c7d1fb07eba6c706394e300a2d0e60529dba3557871649014
ARG EAGER_WRAPPER_SHA256=eecb84231e30482cd26128dfff932fb255bcfb360cdc90f68ddc9bf4998c9ced

COPY glm_official_indexer.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/glm_official_indexer.py
COPY deepseek_v2.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_v2.py
COPY vllm-official-reference-eager /usr/local/libexec/glm52-reference/vllm

RUN set -eu; \
    echo "${GLM_REFERENCE_INDEXER_SHA256}  /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/glm_official_indexer.py" | sha256sum -c -; \
    echo "${DEEPSEEK_V2_SHA256}  /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_v2.py" | sha256sum -c -; \
    echo "${EAGER_WRAPPER_SHA256}  /usr/local/libexec/glm52-reference/vllm" | sha256sum -c -; \
    chmod 0755 /usr/local/libexec/glm52-reference/vllm; \
    /opt/venv/bin/python -m py_compile \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/glm_official_indexer.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_v2.py; \
    grep -q 'q_chunk_rows: int = 16' /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/glm_official_indexer.py; \
    grep -q 'k_cache_official_bf16_v1' /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_v2.py; \
    grep -q '_normalize_decode_seq_lens' /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/glm_official_indexer.py; \
    grep -q '_require_zero_based_key_windows' /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/glm_official_indexer.py

ENV PATH="/usr/local/libexec/glm52-reference:${PATH}"

