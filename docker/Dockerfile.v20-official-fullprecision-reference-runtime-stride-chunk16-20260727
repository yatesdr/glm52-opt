LABEL local.glm52.base.vllm.commit="0c79e41db41f250ccdfc4be92d171960a5787f73"
LABEL local.glm52.base.sparkinfer.commit="c3828fd7f807ce237a9ac36ef033659e6f6b6dd3"
LABEL local.glm52.reference.vllm.commit="75715e519b73b712873e488f7c42c8d61d14dbbc"
