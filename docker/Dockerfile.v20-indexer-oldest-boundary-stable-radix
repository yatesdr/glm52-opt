FROM glm52-serve:v20-20260727-indexer-oldest-boundary-causal-r2

ARG TILED_TOPK_INPUT_SHA256=4d89638440a1bab62d632a4ebbba3de2cdbda8bc5bcd5c8d559b940d8c45e42e
ARG TILED_TOPK_OUTPUT_SHA256=51318b043a200f9fafc7bf59407bbc8047c0ae99806d847e8d0418ec7b05e3b9

USER root

RUN test "$(sha256sum /opt/venv/lib/python3.12/site-packages/sparkinfer/attention/nsa_indexer/tiled_topk.py | cut -d' ' -f1)" = "${TILED_TOPK_INPUT_SHA256}"

COPY tiled_topk.py /opt/venv/lib/python3.12/site-packages/sparkinfer/attention/nsa_indexer/tiled_topk.py

RUN test "$(sha256sum /opt/venv/lib/python3.12/site-packages/sparkinfer/attention/nsa_indexer/tiled_topk.py | cut -d' ' -f1)" = "${TILED_TOPK_OUTPUT_SHA256}" \
    && /opt/venv/bin/python -m py_compile \
        /opt/venv/lib/python3.12/site-packages/sparkinfer/attention/nsa_indexer/tiled_topk.py \
    && /opt/venv/bin/python -c "from sparkinfer.attention.nsa_indexer.tiled_topk import _resolve_selection_policy as r; assert r(' oldest_boundary ') == 'oldest_boundary'"

