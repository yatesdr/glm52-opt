+            route_expert_ids_ptr,
+            layout=cute.make_layout((active_m * Int32(self.topk),), stride=(1,)),
+        )
+        tier_local_map_flat = cute.make_tensor(
+            tier_local_map_ptr,
+            layout=cute.make_layout((self.map_slots,), stride=(1,)),
+        )
