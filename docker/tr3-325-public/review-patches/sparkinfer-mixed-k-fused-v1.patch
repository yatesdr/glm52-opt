+class W4A16TopKSumTwoTierFullRotationKernel:
+    """Full-rotation top-k sum preserving serial tier association.
+
+    The current mixed-K reference computes ``sum(tier0_routes)`` and
+    ``sum(tier1_routes)`` independently in FP32, then adds the two FP32
+    results.  A single interleaved route accumulator is not bit-identical for
+    all inputs.  This kernel keeps two accumulators and performs the same final
+    tier0+tier1 addition while consuming the fused route-output buffer once.
+    """
+
+    ABI_VERSION = 2
+
+    def __init__(self, *, topk: int, hidden_size: int, map_slots: int):
+        if int(topk) <= 0 or int(hidden_size) <= 0:
+            raise ValueError("topk and hidden_size must be positive")
+        if int(hidden_size) % 128 != 0:
+            raise ValueError("two-tier full-rotation sum requires H % 128 == 0")
+        if int(map_slots) <= 0:
+            raise ValueError("map_slots must be positive")
+        self.topk = int(topk)
+        self.hidden_size = int(hidden_size)
+        self.map_slots = int(map_slots)
+        self.cta_threads = 256
+
+    @property
+    def __cache_key__(self) -> tuple[object, ...]:
+        return (
+            "w4a16_topk_sum_two_tier_full_rotation",
+            self.ABI_VERSION,
+            self.topk,
+            self.hidden_size,
+            self.map_slots,
+            self.cta_threads,
+        )
