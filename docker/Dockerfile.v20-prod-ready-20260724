COPY workspace/vllm-v20-staged-bf16-fp8-query/vllm/v1/attention/backends/mla/b12x_mla_sparse.py \
    /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/b12x_mla_sparse.py
COPY workspace/vllm-v20-staged-bf16-fp8-query/vllm/model_executor/kernels/attention/b12x_mxfp8_bmm.py \
    /opt/venv/lib/python3.12/site-packages/vllm/model_executor/kernels/attention/b12x_mxfp8_bmm.py
COPY workspace/vllm-v20-staged-bf16-fp8-query/vllm/v1/worker/gpu/model_runner.py \
    /opt/venv/lib/python3.12/site-packages/vllm/v1/worker/gpu/model_runner.py
COPY workspace/sparkinfer-v20-current-recovery/sparkinfer/comm/pcie/pcie_dma.py \
    /opt/venv/lib/python3.12/site-packages/sparkinfer/comm/pcie/pcie_dma.py

RUN /opt/venv/bin/python -m py_compile \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/kv_offload/tiering/fs/manager.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/indexer.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/attention/mla_attention.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backend.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/b12x_mla_sparse.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/kernels/attention/b12x_mxfp8_bmm.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/worker/gpu/model_runner.py \
      /opt/venv/lib/python3.12/site-packages/sparkinfer/comm/pcie/pcie_dma.py \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/v1/kv_offload/tiering/fs/manager.py | cut -d ' ' -f 1)" = "653edbf4b393e2acd6204bf4664c300eaee9e959656040864491c94548b4cc60" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/indexer.py | cut -d ' ' -f 1)" = "23ad50cb6017e54f1c9fee76b0d999e3544d584e9377fc776041bfa3d2d2b821" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/attention/mla_attention.py | cut -d ' ' -f 1)" = "e26e59551b392ed9ddb307276cebf9082eb5a3cb2d1e53c216ac15c7bd520a33" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backend.py | cut -d ' ' -f 1)" = "1c18cf73b5012ceea610b23e45fa18bbd3847a37523238861ee8fb1b77464304" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/b12x_mla_sparse.py | cut -d ' ' -f 1)" = "885401fc5dc10dcfa02fe6fc524763bb9a44150e4cf743c1e6f9a3460002da74" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/model_executor/kernels/attention/b12x_mxfp8_bmm.py | cut -d ' ' -f 1)" = "d86b31543fa308b77bfff32b7a674646dcc2d250a7309ec6e5e621032deeb397" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/vllm/v1/worker/gpu/model_runner.py | cut -d ' ' -f 1)" = "85dedfb225b8e3f239f23590bb2143498f8b5bed453d4efcd83208d88e9c4647" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/sparkinfer/comm/pcie/pcie_dma.py | cut -d ' ' -f 1)" = "42ec698533d9404c20672d6b0800961cef1387833725b8762dd5469f78673ee3" \
    && test "$(sha256sum /opt/venv/lib/python3.12/site-packages/sparkinfer/attention/nsa_indexer/tiled_topk.py | cut -d ' ' -f 1)" = "57d5ec00c70e60024bd94bb6afbb9174144c9c07cf88e5568a996ab511bc24c5"
